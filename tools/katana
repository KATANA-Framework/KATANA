#!/usr/bin/env bash
# katana — one-command dev orchestrator for a KATANA fullstack service.
#
#   katana dev   [service-dir]   bring up deps (Postgres+Redis) + backend + frontend, watch, tail
#   katana up    [service-dir]   start just the dependencies (docker compose)
#   katana down  [service-dir]   stop the dependencies
#   katana build [service-dir]   (re)generate contracts + build the backend
#
# service-dir defaults to submodules/Vigil (the reference consumer). It must contain a
# CMakeLists.txt, a docker-compose.yml, and a web/ frontend.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CMD="${1:-dev}"
SVC="${2:-$ROOT/submodules/Vigil}"
SVC="$(cd "$SVC" && pwd)"

c_g="\033[32m"; c_y="\033[33m"; c_d="\033[2m"; c_0="\033[0m"
say() { echo -e "${c_g}▸${c_0} $*"; }
warn() { echo -e "${c_y}!${c_0} $*" >&2; }
die() { echo -e "\033[31m✗ $*${c_0}" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not found. $2"; }

# Single source of truth (DX-19): one $SVC/.env feeds docker-compose, the backend process, AND the
# frontend, so the host port / DSN can't drift from what compose actually publishes. Compose reads it
# via --env-file (ENV_FILE below); the backend inherits it as exported env; the frontend gets an
# API base derived from the same API_PORT. Missing .env → built-in defaults, unchanged behaviour.
ENV_FILE="$SVC/.env"
if [ -f "$ENV_FILE" ]; then
  set -a; . "$ENV_FILE"; set +a
fi
API_PORT="${API_PORT:-${PORT:-8080}}"
WEB_PORT="${WEB_PORT:-3000}"
PG_USER="${PG_USER:-katana}"
PG_DB="${PG_DB:-katana}"

compose() {
  if docker compose version >/dev/null 2>&1; then docker compose "$@";
  elif command -v docker-compose >/dev/null 2>&1; then docker-compose "$@";
  else die "docker compose not found. Install Docker."; fi
}

# Thread the shared .env into compose so the containers publish exactly the ports/creds the host uses.
dc() {
  local env_arg=()
  [ -f "$ENV_FILE" ] && env_arg=(--env-file "$ENV_FILE")
  compose --project-directory "$SVC" "${env_arg[@]}" -f "$SVC/docker-compose.yml" \
    -p "$(basename "$SVC")" "$@"
}

deps_up() {
  need docker "Install Docker to run the dependencies."
  say "starting dependencies (Postgres + Redis)…"
  dc up -d
  say "waiting for Postgres to be ready…"
  for _ in $(seq 1 30); do
    if dc exec -T postgres pg_isready -U "$PG_USER" -d "$PG_DB" >/dev/null 2>&1; then
      say "dependencies ready"; return 0
    fi
    sleep 1
  done
  die "Postgres did not become ready in time (check: katana down, then retry)."
}

deps_down() {
  need docker "Install Docker to manage the dependencies."
  say "stopping dependencies…"
  dc down
}

build_backend() {
  need cmake "Install cmake + ninja and a C++23 compiler."
  say "configuring + building backend ($(basename "$SVC"))…"
  cmake -S "$SVC" -B "$SVC/build" -G Ninja >/dev/null
  cmake --build "$SVC/build"
}

dev() {
  need npm "Install Node.js (npm) to run the frontend."
  deps_up
  build_backend

  local bin="$SVC/build/$(basename "$SVC")"
  [ -x "$bin" ] || die "backend binary not found at $bin"

  # Ensure frontend deps.
  if [ ! -d "$SVC/web/node_modules" ]; then
    say "installing frontend deps…"
    (cd "$SVC/web" && npm install >/dev/null)
  fi

  local pids=()
  cleanup() {
    echo
    say "shutting down…"
    for p in "${pids[@]:-}"; do kill "$p" >/dev/null 2>&1 || true; done
    deps_down || true
  }
  trap cleanup EXIT INT TERM

  # Frontend talks to the backend at the SAME API_PORT the backend binds — both from .env.
  local api_base="${API_BASE_URL:-http://localhost:$API_PORT}"

  # The backend inherits the exported .env (its own PREFIX_* keys — e.g. VIGIL_PORT / VIGIL_DATABASE_URL
  # — plus the compose creds), so it connects to exactly the deps compose just published.
  say "starting backend on :$API_PORT  ${c_d}(logs prefixed [api])${c_0}"
  ( "$bin" 2>&1 | sed "s/^/$(printf '\033[36m[api]\033[0m') /" ) &
  pids+=($!)

  say "starting frontend on :$WEB_PORT  ${c_d}(logs prefixed [web])${c_0}"
  ( cd "$SVC/web" && PORT="$WEB_PORT" NEXT_PUBLIC_API_BASE_URL="$api_base" \
      npm run dev 2>&1 | sed "s/^/$(printf '\033[35m[web]\033[0m') /" ) &
  pids+=($!)

  echo
  say "up: ${c_d}api${c_0} $api_base  ·  ${c_d}web${c_0} http://localhost:$WEB_PORT  ·  Ctrl-C to stop"
  wait
}

case "$CMD" in
  dev) dev ;;
  up) deps_up ;;
  down) deps_down ;;
  build) build_backend ;;
  -h|--help|help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0" ;;
  *) die "unknown command '$CMD' (try: dev, up, down, build, help)" ;;
esac
